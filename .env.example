# Gateway
PORT=8080
CATALOG_DIR=catalog
PROBE_FILE=data/probes.json
PROBES_ENABLED=true
PROBE_INTERVAL_MIN=30
PROBE_ORIGIN=https://apiscope.dev
READ_RPM=240
TRY_RPM=30
TRUST_PROXY=false          # true only behind a proxy you control
ALLOW_ORIGIN=              # set only if the browser calls the gateway directly
RUNNER_URL=http://runner:8081 # used automatically when the sandbox profile is enabled
# Web (baked in at build time)
GATEWAY_URL=http://localhost:8080
