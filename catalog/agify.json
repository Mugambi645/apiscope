  "categories": [
    "ai",
    "data"
  ],
  "tags": [
    "prediction",
    "names",
    "demographics"
  ],
  "regions": [
    "global"
  ],
  "auth": "none",
  "cors": true,
  "license": "Free tier",
  "base_url": "https://api.agify.io",
  "docs_url": "https://agify.io/documentation",
  "endpoints": [
    {
      "name": "Predict age",
      "method": "GET",
      "path": "/",
