      "params": [
        {
          "name": "name",
          "in": "query",
          "required": true,
          "example": "wanjiru",
          "description": ""
        },
        {
          "name": "country_id",
          "in": "query",
          "required": false,
          "example": "KE",
          "description": ""
        }
      ]
    }
  ]
